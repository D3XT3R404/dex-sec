# Demo environment file with FAKE values, used to test the DEX-SEC scanner.
# These are not real credentials - they only exist so the scanner has
# something to detect. Never put a real secret in a repository.
APP_ENV=production
DATABASE_URL=postgres://demo:demo@localhost:5432/demo
JWT_SIGNING_KEY=dummy-not-a-real-signing-key-0000000000
STRIPE_SECRET_KEY=dummy-not-a-real-stripe-key-0000
REDIS_PASSWORD=dummy-not-a-real-password-000
SENTRY_DSN=https://dummy-not-a-real-token@sentry.invalid/12345
